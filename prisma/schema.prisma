generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// Identity: DM runs embedded inside a creator's own Whop dashboard
// (app/dashboard/[companyId]/), authenticated via the x-whop-user-token
// header Whop passes on every request — see lib/whop/dashboard-auth.ts.
// Whop is the identity provider; there is no separate DM login, session
// table, or per-creator OAuth connection. A Creator record is keyed
// directly to the Whop company (biz_xxx) that installed the app, and
// read access to that company's catalog comes from a single shared
// app-level API key plus the permissions granted at install time — not
// a per-creator OAuth token that can expire independently.
// ---------------------------------------------------------------

// ---------------------------------------------------------------
// DM domain model
// ---------------------------------------------------------------

enum DmSubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum OfferSource {
  WHOP
  CUSTOM
}

enum OfferType {
  MEMBERSHIP
  COURSE
  COACHING
  CONSULTING
  FREE
}

// How the price is presented — mirrors the six card variants in 4F.
enum PriceUnit {
  RECURRING_MONTH
  ONE_TIME
  PER_SESSION
  PROJECT
  FREE
}

enum ClickSourceBucket {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  DIRECT
  OTHER
}

model Creator {
  id String @id @default(cuid())

  // The Whop company (biz_xxx) that installed the DM dashboard app — this
  // *is* the Creator's identity. One company installs the app once, gets
  // one Creator record. whopUserId is whichever admin's token most
  // recently verified against it (used to correlate the DM Pro billing
  // webhook — see lib/whop/webhooks.ts); identity is the company, not the
  // individual user, since multiple admins on one company see the same page.
  whopCompanyId String  @unique
  whopUserId    String?

  handle    String  @unique
  name      String
  tagline   String?
  bio       String?
  avatarUrl String?
  // Read-only, populated from Whop's account data on sync — not creator-editable.
  verified  Boolean @default(false)

  featuredOfferId String? @unique
  featuredOffer   Offer?  @relation("FeaturedOffer", fields: [featuredOfferId], references: [id], onDelete: SetNull)

  offers      Offer[]      @relation("CreatorOffers")
  links       Link[]
  clickEvents ClickEvent[]

  // Catalog sync freshness. No connect/disconnect state to track — access
  // is via the app's single WHOP_API_KEY plus permissions granted at
  // install, not a per-creator token that can expire independently.
  lastSyncedAt DateTime?

  // DM's own subscription (a separate Whop company/product from anything
  // the creator sells) — flipped by webhook. Flat $15/mo, one plan, no
  // tiers — see the build brief.
  dmSubscriptionStatus DmSubscriptionStatus @default(INACTIVE)
  dmWhopMembershipId   String?

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dmSubscriptionStatus])
}

model Offer {
  id        String  @id @default(cuid())
  creatorId String
  creator   Creator @relation("CreatorOffers", fields: [creatorId], references: [id], onDelete: Cascade)
  featuredFor Creator? @relation("FeaturedOffer")

  source OfferSource @default(WHOP)

  // ---- Synced from Whop — never accepted by the offer edit API ----
  whopProductId   String?
  type            OfferType
  name            String
  priceCents      Int?
  priceUnit       PriceUnit
  whopCheckoutUrl String?

  // ---- Creator-editable ----
  description  String?
  thumbnailUrl String?
  visible      Boolean @default(true)
  sortOrder    Int     @default(0)

  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clickEvents ClickEvent[]

  @@unique([creatorId, whopProductId])
  @@index([creatorId])
}

model Link {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([creatorId])
}

model ClickEvent {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Null offerId = a page visit. Set = a handoff click on that offer.
  offerId   String?
  offer     Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  timestamp DateTime @default(now())
  referrer  String?
  sourceBucket ClickSourceBucket @default(DIRECT)

  @@index([creatorId, timestamp])
  @@index([offerId])
}

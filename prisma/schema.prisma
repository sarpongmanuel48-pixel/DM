generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------
// Identity: DM runs embedded inside a creator's own Whop dashboard
// (app/dashboard/[companyId]/), authenticated via the x-whop-user-token
// header Whop passes on every request — see lib/whop/dashboard-auth.ts.
// Whop is the identity provider for this phase; there is no separate DM
// login or session table. A Creator's link to the platform(s) they've
// connected lives on `Connection`, not on `Creator` itself — see that
// model below and lib/connectors/. Whop's Connection reads a company's
// catalog via a single shared app-level API key plus the permissions
// granted at install time, not a per-creator OAuth token that can expire
// independently — see Connection.credentialType.
// ---------------------------------------------------------------

// ---------------------------------------------------------------
// DM domain model
// ---------------------------------------------------------------

enum DmSubscriptionStatus {
  ACTIVE
  INACTIVE
}

enum OfferSource {
  WHOP
  CUSTOM
}

enum OfferType {
  MEMBERSHIP
  COURSE
  COACHING
  CONSULTING
  FREE
  // A connector reported a product it couldn't classify into a more
  // specific bucket — Whop's own detection never emits this today, but a
  // future connector's might. See lib/connectors/types.ts.
  OTHER
}

// How the price is presented — mirrors the six card variants in 4F.
enum PriceUnit {
  RECURRING_MONTH
  ONE_TIME
  PER_SESSION
  PROJECT
  FREE
}

enum ClickSourceBucket {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  DIRECT
  OTHER
}

model Creator {
  id String @id @default(cuid())

  // Whichever admin's token most recently verified against this creator's
  // Whop connection (used to correlate the DM Pro billing webhook — see
  // lib/whop/webhooks.ts). This is DM's own billing-correlation identity,
  // not a platform connection — it stays here rather than on Connection
  // because a future connector may have no equivalent "which user" concept
  // at all, and it isn't part of what makes a Connection unique.
  whopUserId String?

  handle      String  @unique
  name        String
  tagline     String?
  bio         String?
  avatarUrl   String?
  // Hex, e.g. "#4F46E5" — rendered as --creator-accent on the storefront and
  // live preview (see app/[handle]/page.tsx, LivePreviewPane.tsx). Null
  // falls back to DEFAULT_ACCENT_COLOR (lib/creator-accent.ts) — the exact
  // #e2680c this repo's own CSS already uses as a fixed "creator accent"
  // (see app/globals.css's header comment), so an unconfigured creator's
  // page looks identical to before this field existed.
  accentColor String?
  // Read-only, populated from Whop's account data on sync — not creator-editable.
  verified    Boolean @default(false)

  featuredOfferId String? @unique
  featuredOffer   Offer?  @relation("FeaturedOffer", fields: [featuredOfferId], references: [id], onDelete: SetNull)

  offers      Offer[]      @relation("CreatorOffers")
  links       Link[]
  clickEvents ClickEvent[]
  connections Connection[]

  // Catalog sync freshness, across all connections. Per-connection
  // freshness lives on Connection.lastSyncedAt.
  lastSyncedAt DateTime?

  // DM's own subscription (a separate Whop company/product from anything
  // the creator sells) — flipped by webhook. Flat $15/mo, one plan, no
  // tiers — see the build brief.
  dmSubscriptionStatus DmSubscriptionStatus @default(INACTIVE)
  dmWhopMembershipId   String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dmSubscriptionStatus])
}

// A creator's connection to one external platform — what generalizes
// beyond Whop. See lib/connectors/types.ts for the Connector contract
// every platform must satisfy, and lib/connectors/registry.ts for how a
// Creator gets resolved from a platform + externalId (the replacement for
// the old direct `Creator.whopCompanyId` lookup).
model Connection {
  id        String  @id @default(cuid())
  creatorId String
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform       String // "whop" today
  // "app_install" for Whop — a single shared app-level API key, scoped by
  // permissions granted when the company installed DM, not a per-creator
  // token. A future OAuth-based connector (e.g. Patreon) would store
  // "oauth" here and its refresh token elsewhere, not on this row.
  credentialType String
  // The platform's own id for this connection — a Whop company id (biz_xxx) today.
  externalId     String

  status       String // "connected" | "paused" | "disconnected"
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@unique([creatorId, platform])
  @@unique([platform, externalId])
}

model Offer {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Creator  @relation("CreatorOffers", fields: [creatorId], references: [id], onDelete: Cascade)
  featuredFor Creator? @relation("FeaturedOffer")

  source OfferSource @default(WHOP)

  // ---- Synced from Whop — never accepted by the offer edit API ----
  whopProductId   String?
  type            OfferType
  name            String
  priceCents      Int?
  priceUnit       PriceUnit
  whopCheckoutUrl String?

  // ---- Creator-editable ----
  description  String?
  thumbnailUrl String?
  visible      Boolean @default(true)
  sortOrder    Int     @default(0)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clickEvents ClickEvent[]

  @@unique([creatorId, whopProductId])
  @@index([creatorId])
}

model Link {
  id        String   @id @default(cuid())
  creatorId String
  creator   Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([creatorId])
}

model ClickEvent {
  id           String            @id @default(cuid())
  creatorId    String
  creator      Creator           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  // Null offerId = a page visit. Set = a handoff click on that offer.
  offerId      String?
  offer        Offer?            @relation(fields: [offerId], references: [id], onDelete: SetNull)
  timestamp    DateTime          @default(now())
  referrer     String?
  sourceBucket ClickSourceBucket @default(DIRECT)

  @@index([creatorId, timestamp])
  @@index([offerId])
}

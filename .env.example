# Postgres connection — Supabase project "dm" (vehetnsecucgdkmhgfdf, us-east-1),
# provisioned via MCP. Password isn't exposed by the API — grab it from
# https://supabase.com/dashboard/project/vehetnsecucgdkmhgfdf/settings/database
# Pooled (transaction mode, port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.vehetnsecucgdkmhgfdf:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"
# Direct (port 5432) — used by Prisma Migrate
DIRECT_URL="postgresql://postgres.vehetnsecucgdkmhgfdf:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Whop app identity — used to verify the aud claim on x-whop-user-token
# (see lib/whop/dashboard-auth.ts). Find both in the app's Developer dashboard.
WHOP_APP_ID=""
# Single shared key covering every company that's installed DM — scoped by
# the permissions (product:basic:read, plan:basic:read, etc.) declared in
# the app's Developer → Permissions tab. Not a per-creator OAuth token.
WHOP_API_KEY=""

# Whop — DM's own company/product, used only for DM Pro billing checkout + webhooks
WHOP_DM_API_KEY=""
WHOP_DM_COMPANY_ID=""
WHOP_DM_PRO_PLAN_ID=""
WHOP_WEBHOOK_SECRET=""

# Verifies requests to /api/sync actually come from Vercel Cron
CRON_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Marketing landing page CTAs link here while self-serve signup doesn't
# exist (see lib/self-serve-signup.ts) — DM's Whop App Store listing.
NEXT_PUBLIC_WHOP_APP_STORE_URL=""
